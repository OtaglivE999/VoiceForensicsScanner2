{
    "name": "Live Scan Default Configuration",
    "description": "Default settings for live audio scanning with dialogue pattern recognition",
    
    "audio_settings": {
        "sample_rate": 16000,
        "channels": 1,
        "segment_duration_ms": 2000,
        "buffer_size_seconds": 30,
        "audio_device": null
    },
    
    "pattern_detection": {
        "enable_coercive_detection": true,
        "enable_emotion_detection": true,
        "enable_dialogue_patterns": true,
        "enable_linguistic_patterns": true,
        "min_confidence": 0.5,
        "alert_threshold": 0.75
    },
    
    "speaker_identification": {
        "enable_diarization": true,
        "enable_voice_fingerprinting": true,
        "enable_speaker_tracking": true
    },
    
    "acceleration": {
        "enable_npu": true,
        "enable_gpu": true,
        "npu_whisper": true,
        "npu_sentiment": true
    },
    
    "alerts": {
        "min_alert_level": "medium",
        "enable_console_alerts": true,
        "enable_file_logging": true,
        "cooldown_seconds": 5.0,
        "escalation_threshold": 3
    },
    
    "output": {
        "output_directory": "./scan_output",
        "save_results": true,
        "save_transcriptions": true,
        "save_audio_segments": true
    },

    "embedding": {
        "model": "vfs-spectral-projection-v1",
        "model_version": "1.0.0",
        "dim": 256,
        "l2_normalized": true,
        "export_per_detection": true,
        "export_per_speaker": true
    },

    "quality_control": {
        "export_speech_seconds": true,
        "export_voiced_fraction": true,
        "export_clipping_pct": true,
        "export_overlap_detected": true,
        "export_reverb_flag": true,
        "export_quality_score": true,
        "min_quality_score": 0.3
    },

    "match_thresholds": {
        "feature_strong": 0.85,
        "feature_candidate": 0.70,
        "feature_inconclusive": 0.55,
        "embedding_strong": 0.85,
        "embedding_candidate": 0.75,
        "embedding_inconclusive": 0.65,
        "cross_model_comparison": false,
        "requires_listening_review": true
    },
    
    "integration": {
        "use_existing_live_matcher": true,
        "use_existing_field_processor": true,
        "use_existing_conversation_dynamics": true,
        "use_existing_diarization": true
    }
}
