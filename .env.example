# Voice Forensics Scanner - Environment Configuration
# Copy this file to .env and customize settings

# =============================================================================
# AUDIO SETTINGS
# =============================================================================

# Sample rate in Hz (16000=speech, 48000=professional)
AUDIO_SAMPLE_RATE=48000

# Number of audio channels (1=mono, 2=stereo)
AUDIO_CHANNELS=1

# Audio device index (use --list-devices to find)
# AUDIO_DEVICE_ID=12

# Audio data type
AUDIO_DTYPE=float32

# Block size in milliseconds
AUDIO_BLOCKSIZE_MS=100

# =============================================================================
# VOICE ACTIVITY DETECTION (VAD)
# =============================================================================

# Energy threshold for voice detection (lower = more sensitive)
VAD_ENERGY_THRESHOLD=0.01

# Speech padding in milliseconds
VAD_SPEECH_PAD_MS=300

# Minimum speech duration in seconds
VAD_MIN_SPEECH_DURATION=0.5

# =============================================================================
# SPEAKER RECOGNITION
# =============================================================================

# Similarity threshold for speaker matching (0.0-1.0)
SPEAKER_SIMILARITY_THRESHOLD=0.75

# Automatically enroll new speakers
AUTO_ENROLL_NEW_SPEAKERS=true

# Maximum speakers to track simultaneously
MAX_TRACKED_SPEAKERS=50

# =============================================================================
# FAR-FIELD DETECTION
# =============================================================================

# Minimum SNR in dB for detection
MIN_SNR_THRESHOLD=2.0

# Enable ultra-sensitive mode by default
ULTRA_SENSITIVE=false

# Enable automatic gain control
AGC_ENABLED=true

# =============================================================================
# OUTPUT SETTINGS
# =============================================================================

# Output directory for logs
OUTPUT_DIR=logs

# Recording directory (if --record enabled)
RECORDING_DIR=recordings

# Log file prefix
LOG_PREFIX=voice_scan

# =============================================================================
# HARDWARE ACCELERATION (Optional)
# =============================================================================

# Enable NPU acceleration (AMD Ryzen AI)
NPU_ENABLED=false

# ONNX Runtime provider (DirectML, CUDA, CPU)
NPU_PROVIDER=DirectML

# =============================================================================
# DASHBOARD SETTINGS
# =============================================================================

# Dashboard port
DASHBOARD_PORT=5050

# Dashboard host
DASHBOARD_HOST=localhost

# =============================================================================
# WHISPER TRANSCRIPTION (Optional)
# =============================================================================

# Whisper model size (tiny, base, small, medium, large)
WHISPER_MODEL=base

# Enable real-time transcription
WHISPER_ENABLED=false
