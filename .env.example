# Enhanced Audio Recording System - Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================================
# AUDIO CONFIGURATION
# ============================================================
# Default sample rate (16000, 44100, 48000, 96000)
AUDIO_SAMPLE_RATE=16000

# Number of audio channels (1=mono, 2=stereo)
AUDIO_CHANNELS=1

# Audio device index (-1 for default device)
AUDIO_DEVICE_INDEX=-1

# Chunk duration in minutes for splitting recordings
AUDIO_CHUNK_DURATION_MINUTES=5

# ============================================================
# VOICE ACTIVITY DETECTION (VAD)
# ============================================================
# Energy threshold for voice detection (0.0 - 1.0)
VAD_ENERGY_THRESHOLD=0.01

# Use adaptive threshold (true/false)
VAD_ADAPTIVE_THRESHOLD=true

# Speech padding in milliseconds
VAD_SPEECH_PAD_MS=300

# ============================================================
# WHISPER TRANSCRIPTION
# ============================================================
# Model size: tiny, base, small, medium, large
WHISPER_MODEL_SIZE=base

# Language code (auto for auto-detect)
WHISPER_LANGUAGE=auto

# Task type: transcribe or translate
WHISPER_TASK=transcribe

# ============================================================
# SENTIMENT ANALYSIS
# ============================================================
# Hugging Face model for sentiment
SENTIMENT_MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment-latest

# Enable sentiment analysis (true/false)
SENTIMENT_ENABLED=true

# ============================================================
# NPU / HARDWARE ACCELERATION
# ============================================================
# Enable NPU acceleration (true/false)
NPU_ENABLED=true

# Preferred execution provider (auto, vitis, directml, cuda, cpu)
NPU_PROVIDER=auto

# Number of threads (0 for auto)
NPU_NUM_THREADS=0

# Enable INT8 quantization for smaller models (true/false)
NPU_USE_INT8=false

# Compute precision (fp32, fp16, int8)
NPU_COMPUTE_PRECISION=fp16

# ============================================================
# OUTPUT CONFIGURATION
# ============================================================
# Output directory for recordings and logs
OUTPUT_DIR=./output

# Save WAV files (true/false)
OUTPUT_SAVE_WAV=true

# Save JSON logs (true/false)
OUTPUT_SAVE_JSON=true

# ============================================================
# LOGGING CONFIGURATION
# ============================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log to file (true/false)
LOG_TO_FILE=true

# Use colored console output (true/false)
LOG_USE_COLORS=true

# Log format: json or text
LOG_FORMAT=text

# Maximum log file size in MB
LOG_MAX_SIZE_MB=10

# Number of backup log files
LOG_BACKUP_COUNT=5
